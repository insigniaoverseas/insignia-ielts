# Copy to .dev.vars (gitignored) and fill in. Names only here — never commit values.
# Deployed values live in Wrangler secrets: npx wrangler secret put <NAME>
# Where each comes from: PROJECT-MEMORY.md §6.

NEXTJS_ENV=development

# Supabase → Project Settings → API
SUPABASE_URL=
# Publishable key (sb_publishable_…) — RLS-scoped requests
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — BYPASSES RLS. Server-only, behind lib/rbac.ts.
SUPABASE_SECRET_KEY=

# Cloudflare R2 S3 API → scoped object-read token for the two project buckets.
# Account id is an identifier, not a secret; the access key pair is secret.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Auth (M1) ────────────────────────────────────────────────────────────────
# Absolute origin that invitation links are built from, no trailing slash.
# Deployed, this lives in wrangler.jsonc `vars` — it is not a secret.
APP_BASE_URL=http://localhost:3000

# From address on invitation email. Must be on a domain verified in Resend.
MAIL_FROM=Insignia IELTS <invites@example.com>

# Resend → API Keys. Sending permission only.
# NOTE: connecting Resend to Supabase covers Supabase Auth's OWN emails (SMTP).
# Our invitation carries our own token, so we send it ourselves and need this.
# Leave unset in development and the invite link prints to the server console.
RESEND_API_KEY=

# Cloudflare → Turnstile → your site. The site key is public (wrangler vars);
# only the secret belongs here. M1-11.
TURNSTILE_SECRET_KEY=
